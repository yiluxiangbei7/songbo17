# LLM 服务配置（复制本文件为 .env 并填写真实值）
# 严禁把真实 .env 提交到 git（已在 .gitignore 中排除）

# 服务端口
PORT=3000

# 大模型平台 API Key（在硅基流动 https://cloud.siliconflow.cn 的「API 密钥」页面创建）
LLM_API_KEY=在这里粘贴你的Key

# 大模型服务地址（硅基流动为 OpenAI 兼容接口）
LLM_BASE_URL=https://api.siliconflow.cn/v1

# 模型名称（实验指导书默认；也可换成列表里的其他免费模型）
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
